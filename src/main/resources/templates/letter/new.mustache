<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>편지 넣기</title>
    <link rel="stylesheet" href="/css/drawer.css?v=20260823">
</head>
<body>
<main class="page-shell letter-write-shell">
    <section class="letter-write" aria-labelledby="write-title">
        <a class="back-link" href="/home?writerType={{writerType}}">닫기</a>

        <p class="eyebrow">익명의 편지</p>
        <h1 id="write-title">편지 넣기</h1>

        <form class="letter-form" action="/letter" method="post">
            <input name="writerType" type="hidden" value="{{writerType}}">

            <label for="letterNumber">넣을 서랍 번호</label>
            <input id="letterNumber" name="letterNumber" type="number" min="1" required>

            <label for="content">내용</label>
            <textarea id="content" name="content" rows="12" required></textarea>

            <div class="letter-actions">
                <a class="secondary-link" href="/home?writerType={{writerType}}">닫기</a>
                <button class="primary-link" type="submit">저장</button>
            </div>
        </form>
    </section>
</main>
</body>
</html>
